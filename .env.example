# Copy to .env.local for local development. Both values are public (they ship to the browser).
# Find them in Supabase: Project Settings > API (or the Connect button).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Never put the service_role / secret key here. The app does not need it.
